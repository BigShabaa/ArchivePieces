@model ArchivePieces.ViewModels.Admin.ProductFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Product" : "Add Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@(isEdit ? Model.Id : null)"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-4">

        <!-- ── LEFT: CORE DETAILS ────────────────────────────────────── -->
        <div class="col-12 col-xl-8">

            <!-- Basic Info -->
            <div class="ap-admin-card mb-4">
                <div class="ap-admin-card-header">PRODUCT DETAILS</div>
                <div class="p-4">
                    <div class="mb-3">
                        <label class="ap-label">PRODUCT NAME *</label>
                        <input asp-for="Name" class="ap-input"
                               placeholder="e.g. ARCHIVE CARGO PANT [BLACK]" />
                        <span asp-validation-for="Name" class="ap-field-error"></span>
                    </div>
                    <div class="mb-3">
                        <label class="ap-label">SLUG (auto-generated if blank)</label>
                        <input asp-for="Slug" class="ap-input"
                               placeholder="archive-cargo-pant-black" />
                        <span asp-validation-for="Slug" class="ap-field-error"></span>
                    </div>
                    <div class="mb-3">
                        <label class="ap-label">DESCRIPTION</label>
                        <textarea asp-for="Description" class="ap-input ap-textarea"
                                  rows="5" placeholder="Product description..."></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="ap-label">PRICE (R) *</label>
                            <input asp-for="Price" type="number" step="0.01"
                                   class="ap-input" placeholder="0.00" />
                            <span asp-validation-for="Price" class="ap-field-error"></span>
                        </div>
                        <div class="col-6">
                            <label class="ap-label">CATEGORY *</label>
                            <select asp-for="CategoryId" class="ap-select ap-input"
                                    asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                                <option value="">— Select —</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="ap-field-error"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Images -->
            <div class="ap-admin-card mb-4">
                <div class="ap-admin-card-header">PRODUCT IMAGES</div>
                <div class="p-4">
                    @if (Model.ExistingImages.Any())
                    {
                        <div class="ap-existing-images mb-3">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div class="ap-existing-img-wrap">
                                    <img src="@img.ImagePath" alt="product image" />
                                    <label class="ap-img-delete-label">
                                        <input type="checkbox" name="DeleteImageIds"
                                               value="@img.Id" class="d-none ap-img-delete-check" />
                                        <span class="ap-img-delete-btn">
                                            <i class="bi bi-trash"></i>
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                        <p class="ap-muted small mb-3">Click the bin icon to mark images for deletion on save.</p>
                    }

                    <label class="ap-label">UPLOAD NEW IMAGES</label>
                    <div class="ap-upload-zone" id="uploadZone">
                        <i class="bi bi-cloud-upload fs-2 d-block mb-2"></i>
                        <p>Drag & drop or click to upload</p>
                        <p class="ap-muted small">JPG, PNG, WEBP — max 5MB each</p>
                        <input type="file" name="NewImages" id="imageInput"
                               accept=".jpg,.jpeg,.png,.webp" multiple class="ap-file-input" />
                    </div>
                    <div class="ap-image-previews mt-3" id="imagePreviews"></div>
                </div>
            </div>

            <!-- Variants / Stock -->
            <div class="ap-admin-card mb-4">
                <div class="ap-admin-card-header">
                    SIZES & STOCK
                    <button type="button" class="btn btn-sm btn-outline-light ms-auto"
                            id="addVariantBtn">+ ADD SIZE</button>
                </div>
                <div class="p-4">
                    <div class="ap-variants-table">
                        <div class="ap-variants-header">
                            <span>SIZE</span>
                            <span>STOCK QTY</span>
                            <span></span>
                        </div>
                        <div id="variantsList">
                            @for (int i = 0; i < Model.Variants.Count; i++)
                            {
                                <div class="ap-variant-row @(Model.Variants[i].Delete ? "d-none" : "")"
                                     data-index="@i">
                                    <input type="hidden"
                                           name="Variants[@i].Id"
                                           value="@Model.Variants[i].Id" />
                                    <input type="hidden"
                                           name="Variants[@i].Delete"
                                           value="false"
                                           class="delete-flag" />
                                    <input type="text"
                                           name="Variants[@i].Size"
                                           value="@Model.Variants[i].Size"
                                           class="ap-input ap-input--sm"
                                           placeholder="e.g. M" />
                                    <input type="number"
                                           name="Variants[@i].StockQuantity"
                                           value="@Model.Variants[i].StockQuantity"
                                           class="ap-input ap-input--sm"
                                           min="0" placeholder="0" />
                                    <button type="button" class="ap-remove-variant-btn"
                                            onclick="removeVariant(this)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── RIGHT: OPTIONS ────────────────────────────────────────── -->
        <div class="col-12 col-xl-4">
            <div class="ap-admin-card mb-4">
                <div class="ap-admin-card-header">PUBLISH</div>
                <div class="p-4">
                    <div class="ap-toggle-row mb-3">
                        <div>
                            <div class="ap-toggle-label">ACTIVE</div>
                            <div class="ap-muted small">Visible on storefront</div>
                        </div>
                        <label class="ap-switch">
                            <input type="checkbox" asp-for="IsActive" />
                            <span class="ap-switch-slider"></span>
                        </label>
                    </div>
                    <div class="ap-toggle-row">
                        <div>
                            <div class="ap-toggle-label">FEATURED</div>
                            <div class="ap-muted small">Show on homepage</div>
                        </div>
                        <label class="ap-switch">
                            <input type="checkbox" asp-for="IsFeatured" />
                            <span class="ap-switch-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary ap-btn-lg">
                    @(isEdit ? "SAVE CHANGES" : "CREATE PRODUCT")
                </button>
                <a href="/admin/products" class="btn btn-outline-light">CANCEL</a>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
// ── Image upload preview ──────────────────────────────────────────
const uploadZone = document.getElementById('uploadZone');
const imageInput = document.getElementById('imageInput');
const previews   = document.getElementById('imagePreviews');

uploadZone.addEventListener('click', () => imageInput.click());
uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('drag-over'); });
uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag-over'));
uploadZone.addEventListener('drop', e => {
    e.preventDefault();
    uploadZone.classList.remove('drag-over');
    imageInput.files = e.dataTransfer.files;
    renderPreviews();
});
imageInput.addEventListener('change', renderPreviews);

function renderPreviews() {
    previews.innerHTML = '';
    Array.from(imageInput.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = e => {
            const div = document.createElement('div');
            div.className = 'ap-preview-img-wrap';
            div.innerHTML = `<img src="${e.target.result}" />`;
            previews.appendChild(div);
        };
        reader.readAsDataURL(file);
    });
}

// ── Delete image checkboxes ───────────────────────────────────────
document.querySelectorAll('.ap-img-delete-label').forEach(label => {
    label.addEventListener('change', function () {
        const checked = this.querySelector('input').checked;
        this.closest('.ap-existing-img-wrap').classList.toggle('marked-delete', checked);
    });
});

// ── Variants ─────────────────────────────────────────────────────
let variantCount = document.querySelectorAll('.ap-variant-row').length;

document.getElementById('addVariantBtn').addEventListener('click', () => {
    const i = variantCount++;
    const row = document.createElement('div');
    row.className = 'ap-variant-row';
    row.dataset.index = i;
    row.innerHTML = `
        <input type="hidden" name="Variants[${i}].Id" value="0" />
        <input type="hidden" name="Variants[${i}].Delete" value="false" class="delete-flag" />
        <input type="text"   name="Variants[${i}].Size" class="ap-input ap-input--sm" placeholder="e.g. XXL" />
        <input type="number" name="Variants[${i}].StockQuantity"
               class="ap-input ap-input--sm" min="0" value="0" />
        <button type="button" class="ap-remove-variant-btn" onclick="removeVariant(this)">
            <i class="bi bi-x"></i>
        </button>`;
    document.getElementById('variantsList').appendChild(row);
});

function removeVariant(btn) {
    const row = btn.closest('.ap-variant-row');
    const flag = row.querySelector('.delete-flag');
    flag.value = 'true';
    row.classList.add('d-none');
}

// ── Auto-generate slug ────────────────────────────────────────────
document.querySelector('input[name="Name"]')?.addEventListener('blur', function () {
    const slugInput = document.querySelector('input[name="Slug"]');
    if (!slugInput.value) {
        slugInput.value = this.value.toLowerCase()
            .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
});
</script>
}
