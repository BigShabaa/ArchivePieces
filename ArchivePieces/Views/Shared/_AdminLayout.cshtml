<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — @ViewData["Title"] — ARCHIVE PIECES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="ap-admin-body">

<div class="ap-admin-wrapper">

    <!-- ── SIDEBAR ──────────────────────────────────────────────────── -->
    <aside class="ap-sidebar">
        <a href="/admin" class="ap-sidebar-brand">ARCHIVE<br/>PIECES</a>
        <nav class="ap-sidebar-nav">
            <div class="ap-sidebar-section">OVERVIEW</div>
            <a href="/admin" class="ap-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>

            <div class="ap-sidebar-section">CATALOGUE</div>
            <a href="/admin/products" class="ap-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminProduct" ? "active" : "")">
                <i class="bi bi-box-seam"></i> Products
            </a>
            <a href="/admin/categories" class="ap-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCategory" ? "active" : "")">
                <i class="bi bi-tag"></i> Categories
            </a>
            <a href="/admin/stock" class="ap-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminStock" ? "active" : "")">
                <i class="bi bi-layers"></i> Stock
            </a>

            <div class="ap-sidebar-section">SALES</div>
            <a href="/admin/orders" class="ap-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminOrder" ? "active" : "")">
                <i class="bi bi-receipt"></i> Orders
            </a>

            <div class="ap-sidebar-section">ACCOUNT</div>
            <a href="/" class="ap-sidebar-link">
                <i class="bi bi-globe2"></i> View Store
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="ap-sidebar-link ap-sidebar-logout">
                    <i class="bi bi-box-arrow-right"></i> Sign Out
                </button>
            </form>
        </nav>
    </aside>

    <!-- ── MAIN CONTENT ─────────────────────────────────────────────── -->
    <div class="ap-admin-main">
        <header class="ap-admin-header">
            <h1 class="ap-admin-title">@ViewData["Title"]</h1>
            <div class="ap-admin-header-right">
                <span class="ap-admin-user">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </span>
            </div>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="ap-admin-alert ap-admin-alert--success">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="ap-admin-alert ap-admin-alert--error">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }

        <div class="ap-admin-content">
            @RenderBody()
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
