<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — ARCHIVE PIECES" : "ARCHIVE PIECES")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<!-- ── ANNOUNCEMENT BAR ──────────────────────────────────────────── -->
<div class="ap-announcement">
    FREE SHIPPING ON ORDERS OVER R1500 &nbsp;·&nbsp; NEW DROP LIVE NOW
</div>

<!-- ── MAIN NAV ──────────────────────────────────────────────────── -->
<nav class="navbar navbar-dark ap-navbar">
    <div class="container-fluid px-4">
        <!-- Mobile toggle -->
        <button class="ap-burger d-lg-none me-3" id="mobileMenuBtn" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>

        <!-- Brand -->
        <a class="ap-brand" asp-controller="Home" asp-action="Index">ARCHIVE PIECES</a>

        <!-- Desktop category nav -->
        <div class="ap-cat-nav d-none d-lg-flex">
            @if (ViewBag.NavCategories != null)
            {
                foreach (var cat in (List<ArchivePieces.Models.Category>)ViewBag.NavCategories)
                {
                    <a asp-controller="Shop" asp-action="Index"
                       asp-route-category="@cat.Slug"
                       class="ap-cat-link @(ViewBag.ActiveCategory == cat.Slug ? "active" : "")">
                        @cat.Name
                    </a>
                }
            }
        </div>

        <!-- Right icons -->
        <div class="ap-nav-right">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin" class="ap-icon-link d-none d-lg-inline-flex" title="Admin">
                        <i class="bi bi-gear"></i>
                    </a>
                }
                <a asp-controller="Order" asp-action="MyOrders"
                   class="ap-icon-link d-none d-lg-inline-flex" title="My Orders">
                    <i class="bi bi-person"></i>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ap-icon-link d-none d-lg-inline-flex" title="Sign Out">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                   class="ap-icon-link d-none d-lg-inline-flex" title="Sign In">
                    <i class="bi bi-person"></i>
                </a>
            }
            <a asp-controller="Cart" asp-action="Index" class="ap-cart-link">
                <i class="bi bi-bag"></i>
                <span class="ap-cart-badge" id="cartCount">0</span>
            </a>
        </div>
    </div>
</nav>

<!-- ── MOBILE DRAWER ─────────────────────────────────────────────── -->
<div class="ap-mobile-overlay" id="mobileOverlay"></div>
<div class="ap-mobile-drawer" id="mobileDrawer">
    <button class="ap-close-btn" id="mobileCloseBtn"><i class="bi bi-x-lg"></i></button>
    <div class="ap-mobile-brand">ARCHIVE PIECES</div>
    <nav class="ap-mobile-nav">
        <a asp-controller="Home" asp-action="Index">HOME</a>
        <a asp-controller="Shop" asp-action="Index">ALL PRODUCTS</a>
        @if (ViewBag.NavCategories != null)
        {
            foreach (var cat in (List<ArchivePieces.Models.Category>)ViewBag.NavCategories)
            {
                <a asp-controller="Shop" asp-action="Index" asp-route-category="@cat.Slug">@cat.Name</a>
            }
        }
        <div class="ap-mobile-divider"></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Order" asp-action="MyOrders">MY ORDERS</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="ap-mobile-nav-btn">SIGN OUT</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">SIGN IN</a>
            <a asp-controller="Account" asp-action="Register">CREATE ACCOUNT</a>
        }
    </nav>
</div>

<!-- ── FLASH MESSAGES ────────────────────────────────────────────── -->
@if (TempData["Success"] != null)
{
    <div class="ap-flash ap-flash--success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="ap-flash ap-flash--error">@TempData["Error"]</div>
}

<!-- ── PAGE CONTENT ─────────────────────────────────────────────── -->
<main>
    @RenderBody()
</main>

<!-- ── FOOTER ────────────────────────────────────────────────────── -->
<footer class="ap-footer">
    <div class="container-fluid px-4">
        <div class="row gy-4">
            <div class="col-12 col-md-4">
                <div class="ap-footer-brand">ARCHIVE PIECES</div>
                <p class="ap-footer-tagline">The archive is open.</p>
            </div>
            <div class="col-6 col-md-2">
                <div class="ap-footer-heading">SHOP</div>
                <a asp-controller="Shop" asp-action="Index">All Products</a>
                @if (ViewBag.NavCategories != null)
                {
                    foreach (var cat in ((List<ArchivePieces.Models.Category>)ViewBag.NavCategories).Take(5))
                    {
                        <a asp-controller="Shop" asp-action="Index" asp-route-category="@cat.Slug">@cat.Name</a>
                    }
                }
            </div>
            <div class="col-6 col-md-2">
                <div class="ap-footer-heading">ACCOUNT</div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Order" asp-action="MyOrders">My Orders</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Sign In</a>
                    <a asp-controller="Account" asp-action="Register">Register</a>
                }
                <a asp-controller="Cart" asp-action="Index">Cart</a>
            </div>
            <div class="col-12 col-md-4">
                <div class="ap-footer-heading">FOLLOW</div>
                <div class="ap-social">
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
        </div>
        <div class="ap-footer-bottom">
            <span>© @DateTime.Now.Year ARCHIVE PIECES</span>
            <span>ALL RIGHTS RESERVED</span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
